#!/usr/bin/env bash
set -Eeuo pipefail

printf 'docker' >>"${EGRESS_FAKE_LOG:?}"
printf ' %q' "$@" >>"$EGRESS_FAKE_LOG"
printf '\n' >>"$EGRESS_FAKE_LOG"

case "${1-}:${2-}" in
  info:|pull:*|compose:version) exit 0 ;;
  run:*)
    if [[ " ${*} " == *' version '* ]]; then
      printf '%s\n' "${EGRESS_FAKE_BINARY_VERSION:-1.2.3}"
    fi
    exit 0
    ;;
  inspect:--format) printf 'true\n'; exit 0 ;;
  container:inspect)
    [[ -e "${EGRESS_FAKE_DOCKER_STATE:?}" ]]
    ;;
  rm:--force)
    rm -f -- "${EGRESS_FAKE_DOCKER_STATE:?}"
    ;;
  compose:*)
    if [[ " $* " == *' up -d '* ]]; then
      : >"${EGRESS_FAKE_DOCKER_STATE:?}"
    elif [[ " $* " == *' down --remove-orphans '* ]]; then
      rm -f -- "${EGRESS_FAKE_DOCKER_STATE:?}"
    fi
    ;;
  *) exit 64 ;;
esac
